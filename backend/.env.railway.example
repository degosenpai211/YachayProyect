# ============================================================
# Variables de entorno para PRODUCCIÓN en Railway.
# Railway → tu proyecto → servicio del backend → pestaña
# "Variables" → "Raw Editor" (puedes pegar todo este bloque
# de una vez ahí) o agrégalas una por una con "New Variable".
#
# Reemplaza los valores entre <> por los tuyos.
# NUNCA subas este archivo ya relleno a GitHub.
# ============================================================

# --- IA (cerebro del tutor) ---
GROQ_API_KEY=<tu_groq_api_key>
ANTHROPIC_API_KEY=

# --- Zavu / Telegram ---
ZAVU_API_KEY=<tu_zavu_api_key>
ZAVU_SEND_URL=https://api.zavu.dev/v1/messages
ZAVU_WEBHOOK_SECRET=<tu_zavu_webhook_secret>
TELEGRAM_BOT_USERNAME=<TuBotReal>

# --- Base de datos ---
# SQLite (default) se pierde en cada redeploy de Railway (filesystem
# efímero). Para producción usa Postgres. Elige UNA de estas opciones:
#
# Opción A — Plugin de Postgres de Railway (recomendado, más simple):
#   En tu proyecto Railway → "+ New" → "Database" → "Add PostgreSQL".
#   Railway crea el servicio y expone la variable ${{Postgres.DATABASE_URL}}.
#   En las variables de TU backend, agrega:
#     DATABASE_URL=${{Postgres.DATABASE_URL}}
#   (Railway resuelve esa referencia solo; no hace falta copiar la URL a mano)
#
# Opción B — Supabase (gratis, si prefieres mantenerlo fuera de Railway):
#   Project Settings → Database → Connection string → modo "Session pooler"
#   Pega la URL completa tal cual (empieza con postgresql://):
#
# Si usas la Opción A, deja esta línea como referencia de Railway:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Audio (opcional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# URL pública HTTPS de este servicio (para que Zavu descargue el MP3 de TTS)
PUBLIC_BASE_URL=https://yachayproyect-production.up.railway.app

# --- Grounding web (opcional, no necesario para el pitch) ---
EXA_API_KEY=
EXA_ENABLED=false

# --- General ---
# false en producción: evita mezclar alumnos reales con el seed de demo
DEMO_MODE=false
# URL exacta de tu sitio en Netlify (sin barra final)
CORS_ORIGINS=https://tu-app.netlify.app

# Railway inyecta $PORT automáticamente; no necesitas declararlo aquí.
